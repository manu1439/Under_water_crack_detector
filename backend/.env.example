# AquaGuard AI — Environment Configuration
# Copy this file to .env and customize as needed.

# Paths (use absolute paths or leave blank for defaults)
# AQUAGUARD_PROJECT_ROOT=c:\majorproj
# AQUAGUARD_DATASET_ROOT=c:\majorproj\dataset
# AQUAGUARD_MODELS_DIR=c:\majorproj\models
# AQUAGUARD_UPLOAD_DIR=c:\majorproj\backend\uploads
# AQUAGUARD_OUTPUT_DIR=c:\majorproj\backend\outputs

# Model
# AQUAGUARD_MODEL_WEIGHTS=c:\majorproj\models\best.pt
# AQUAGUARD_BASE_MODEL=yolo26n.pt
# AQUAGUARD_INFERENCE_IMG_SIZE=640
# AQUAGUARD_DEFAULT_CONFIDENCE=0.25
# AQUAGUARD_DEFAULT_IOU=0.45
# AQUAGUARD_DEVICE=auto

# Frame Extraction
# AQUAGUARD_FRAME_INTERVAL=30
# AQUAGUARD_BLUR_THRESHOLD=100.0
# AQUAGUARD_BRIGHTNESS_MIN=30.0
# AQUAGUARD_BRIGHTNESS_MAX=240.0
# AQUAGUARD_CONTRAST_MIN=20.0
# AQUAGUARD_DUPLICATE_HASH_THRESHOLD=8

# Enhancement
# AQUAGUARD_CLAHE_CLIP_LIMIT=3.0
# AQUAGUARD_CLAHE_TILE_GRID=8
# AQUAGUARD_DEFAULT_GAMMA=1.5

# Training
# AQUAGUARD_EPOCHS=50
# AQUAGUARD_BATCH_SIZE=16
# AQUAGUARD_WORKERS=4
# AQUAGUARD_TRAIN_IMG_SIZE=640

# Upload
# AQUAGUARD_MAX_UPLOAD_SIZE_MB=500

# Server
# AQUAGUARD_API_HOST=0.0.0.0
# AQUAGUARD_API_PORT=8000
# AQUAGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
